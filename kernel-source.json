    "optimization_kernel":  {
                                "resident_policy":  "minimal-stable-skeleton-only",
                                "resident_semantics":  "resident means short canon atom, never full doctrine body",
                                "mount_policy":  "minimal-gap-first",
                                "tool_output_policy":  "compress-before-reuse-preserve-evidence",
                                "evidence_retention_policy":  "raw-handle-kept-summary-fed",
                                "prefix_cache_discipline":  "byte-stable-prefix-volatile-facts-late",
                                "prefix_canon_policy":  "ordered-fields-short-canon-no-duplicate-phrasing",
                                "sparse_context_policy":  "MoE-style top-k activation: only the owner profile, triggered officers, selected skill, and evidence handles enter context",
                                "hotpath_manifest":  "hotpath-manifest.json",
                                "context_bloat_gate":  "context-bloat-audit",
                                "runtime_context_gate":  "runtime-context-audit",
                                "runtime_context_policy":  "token, cost, cache, backend usage, or outer-context claims require numeric-only runtime usage evidence; raw prompts, messages, content, secrets, and sessions are forbidden",
                                "cache_volume_policy":  "high hit rate is not enough; a 200k cached/blue-hit line is usually long resident or outer context bloat; cached_tokens_p95, fresh_input_tokens_p95, output_tokens_p95, uncached_tokens_p95, reused_prefix_bytes_p95, input_tokens_p95, activated officers, loaded bytes, and largest segment must stay under budget",
                                "context_slimming_policy":  "preserve high hit by keeping a small byte-stable prefix, but reduce total volume by replacing long history with task-state summaries, evidence handles, source cards, range reads, and on-demand owner/skill/officer mounts; never move savings into larger fresh input or verbose output",
                                "concise_execution_policy":  "short precise single-message execution; prior art before invention when uncertain; no verbose status padding; no shifting cost from cached prefix into uncached input or output",
                                "target_page_replacement_policy":  "when the user asks to modify or redesign a specific page or screen, replace the active target surface in place; do not add a parallel v2, compatibility page, wrapper, or duplicate route unless explicitly requested; migrate imports, routes, tests, and assets; delete or retire superseded page files before completion; verify the actually opened route resolves to the new implementation",
                                "execution_goal":  "single-pass-success-over-short-answer",
                                "pre_final_exhaustion_policy":  "before final on direct execution with meaningful edits or review claims, run one bounded high-yield residual, evidence, and audit scan inside the approved scope; light tasks must not expand into broad residue sweeps by default",
                                "premature_stop_policy":  "passing a core test is not completion when fresh low-cost verification, residue cleanup, or current-audit refresh remains available",
                                "objective":  "smaller-stable-prefix-with-equal-or-better-hit-rate"
                            },
    "purity_budgets":  {
