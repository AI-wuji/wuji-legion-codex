{
  "id": "documents",
  "description": "Create, edit, inspect, render, and verify Word, PDF, and spreadsheet artifacts through complete official packages.",
  "triggers": [
    "word",
    "docx",
    "pdf",
    "文档",
    "报告文件",
    "电子表格",
    "xlsx",
    "excel",
    "word document",
    "pdf report",
    "create document",
    "生成文档",
    "写报告"
  ],
  "status": "callable",
  "primary_skill": "wuji-document-suite",
  "host_callable": false,
  "direct_mount": true,
  "fallback": "native GPT artifact route",
  "sources": [
    {
      "id": "wuji-document-suite-unified",
      "globs": [
        "${ROOT}/capabilities/documents/skills/wuji-document-suite"
      ],
      "required": [
        "SKILL.md",
        "agents/openai.yaml"
      ],
      "lifecycle": "callable",
      "entrypoint": "SKILL.md",
      "priority": "primary"
    },
    {
      "id": "officecli-stateless-adapter",
      "globs": [
        "${ROOT}/capabilities/documents/adapters/officecli"
      ],
      "required": [
        "ENTRYPOINT.md",
        "invoke-officecli.ps1"
      ],
      "lifecycle": "behavior-verified",
      "activation": [
        "officecli",
        "office cli",
        "export word structure",
        "export excel structure",
        "export xlsx structure",
        "导出word结构",
        "导出excel结构",
        "导出xlsx结构",
        "render word html",
        "render excel html",
        "dump word",
        "dump excel",
        "dump xlsx"
      ],
      "entrypoint": "ENTRYPOINT.md",
      "priority": "secondary"
    },
    {
      "id": "documents-complete",
      "globs": [
        "${USERPROFILE}/.codex/plugins/cache/openai-primary-runtime/documents/*/skills/documents"
      ],
      "required": [
        "SKILL.md"
      ],
      "priority": "secondary"
    },
    {
      "id": "pdf-complete",
      "globs": [
        "${USERPROFILE}/.codex/plugins/cache/openai-primary-runtime/pdf/*/skills/pdf"
      ],
      "required": [
        "SKILL.md"
      ],
      "priority": "secondary"
    },
    {
      "id": "spreadsheets-complete",
      "globs": [
        "${USERPROFILE}/.codex/plugins/cache/openai-primary-runtime/spreadsheets/*/skills/spreadsheets"
      ],
      "required": [
        "SKILL.md"
      ],
      "priority": "secondary"
    }
  ],
  "probe": {
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "${ROOT}/scripts/verify-capability-smoke.ps1",
      "-Capability",
      "documents"
    ],
    "fixture": "documents-smoke-v1",
    "kind": "smoke",
    "timeout_seconds": 60
  }
}
