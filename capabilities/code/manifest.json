{
  "id": "code",
  "description": "Direct code changes, bug fixes, and targeted verification with sparse project context.",
  "triggers": [
    "代码",
    "编程",
    "bug",
    "修复",
    "接口",
    "api",
    "组件",
    "函数",
    "开发",
    "refactor",
    "implement",
    "fix",
    "code",
    "coding",
    "bugfix",
    "implement feature",
    "write code",
    "改代码",
    "修bug",
    "实现功能"
  ],
  "status": "behavior-verified",
  "primary_skill": "native Codex coding route",
  "host_callable": true,
  "fallback": "native Codex coding route",
  "sources": [
    {
      "id": "ponytail-complete",
      "globs": [
        "${WUJI_PROJECTS}/wuji-capability-sources/upstream-snapshots/ponytail"
      ],
      "required": [
        "LICENSE",
        "AGENTS.md",
        "skills/ponytail/SKILL.md",
        "skills/ponytail-audit/SKILL.md",
        "tests/*.test.js",
        "package.json"
      ],
      "lifecycle": "assets-retained",
      "priority": "secondary"
    }
  ],
  "experts": [
    {
      "id": "implementation",
      "purpose": "smallest complete implementation",
      "independent": true,
      "model_class": "terra"
    },
    {
      "id": "verification",
      "purpose": "targeted regression verification",
      "independent": false,
      "model_class": "luna"
    }
  ],
  "probe": {
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "${ROOT}/scripts/verify-code.ps1"
    ],
    "fixture": "code-ponytail-fusion-v3",
    "kind": "behavior",
    "timeout_seconds": 120,
    "required_evidence": ["assertions"],
    "comparison_evidence": "assertions"
  }
}
