{
  "id": "feishu",
  "description": "Read and search user-authorized Feishu/Lark content through the official authenticated lark-cli; existing content stays read-only unless an explicit edit is requested.",
  "triggers": [
    "feishu",
    "lark",
    "my.feishu.cn",
    "feishu.cn",
    "larksuite.com",
    "飞书",
    "飞书文档",
    "飞书知识库"
  ],
  "status": "callable",
  "primary_skill": "feishu-lark",
  "direct_mount": true,
  "fallback": "ask the user to authenticate the official lark-cli or provide accessible content",
  "sources": [
    {
      "id": "official-lark-cli-skill",
      "globs": [
        "${ROOT}/capabilities/feishu/skills/feishu-lark",
        "${USERPROFILE}/.codex/skills/feishu-lark"
      ],
      "required": [
        "SKILL.md",
        "agents/openai.yaml",
        "official/lark-shared/SKILL.md",
        "official/lark-doc/SKILL.md",
        "official/lark-wiki/SKILL.md",
        "official/lark-task/SKILL.md"
      ],
      "lifecycle": "callable",
      "entrypoint": "SKILL.md",
      "priority": "primary"
    }
  ],
  "probe": {
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "${ROOT}/scripts/verify-feishu.ps1"
    ],
    "fixture": "official-lark-cli-install-status-v2",
    "kind": "smoke",
    "timeout_seconds": 30
  }
}
